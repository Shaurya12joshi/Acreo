{
  "manifest_version": 3,
  "name": "ACREO",
  "version": "0.3.0",
  "description": "Collects rental listings from multiple sites into one view.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.magicbricks.com/*", "*://*.99acres.com/*", "*://*.nobroker.in/*"],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_title": "Open Acreo"
  },
  "content_scripts": [
    {
      "matches": ["*://*.magicbricks.com/*"],
      "js": ["content-scripts/magicbricks.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.99acres.com/*"],
      "js": ["content-scripts/99acres.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.nobroker.in/*"],
      "js": ["content-scripts/nobroker.js"],
      "run_at": "document_idle"
    }
  ]
}